# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Base URL of your existing backend (the sih26009-moil service).
# NOTE: https://github.com/manjirirelekar47/sih26009-moil returns HTTP 404
# (private or renamed), so no route could be verified against it.
# Every endpoint path lives in ONE file: lib/api.ts  ->  ENDPOINTS
# Point them there once, and the whole dashboard lights up.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Geospatial
# ---------------------------------------------------------------------------
# Mapbox public token. If empty, the map widgets render a built-in
# placeholder canvas instead of failing (so the app always builds/runs).
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAP_STYLE=mapbox://styles/mapbox/satellite-streets-v12
